<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ONLINE MULTIPLAYER"
        android:textSize="32sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jouez avec un ami en ligne"
        android:textSize="16sp"
        android:textColor="#c792ea"
        android:layout_marginBottom="30dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_background"
        android:padding="20dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choisissez votre symbole"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="10dp"/>

        <RadioGroup
            android:id="@+id/onlineSymbolGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/onlineRadioX"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:text="X"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/radio_selector_x"
                android:button="@null"
                android:gravity="center"
                android:layout_marginEnd="10dp"/>

            <RadioButton
                android:id="@+id/onlineRadioO"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:text="O"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/radio_selector_o"
                android:button="@null"
                android:gravity="center"/>
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre de parties"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="10dp"/>

        <RadioGroup
            android:id="@+id/onlineGamesGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/onlineRadio1"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="1"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/radio_selector_games"
                android:button="@null"
                android:gravity="center"
                android:layout_marginEnd="10dp"/>

            <RadioButton
                android:id="@+id/onlineRadio5"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="5"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/radio_selector_games"
                android:button="@null"
                android:gravity="center"
                android:layout_marginEnd="10dp"/>

            <RadioButton
                android:id="@+id/onlineRadio10"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="10"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/radio_selector_games"
                android:button="@null"
                android:gravity="center"
                android:layout_marginEnd="10dp"/>

            <RadioButton
                android:id="@+id/onlineRadio15"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="15"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/radio_selector_games"
                android:button="@null"
                android:gravity="center"/>
        </RadioGroup>

        <Button
            android:id="@+id/createGameButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Créer une partie"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_play"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/gameIdDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="20sp"
            android:textColor="#c792ea"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="20dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#c792ea"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rejoindre une partie"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/gameIdEditText"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Entrez l'ID de la partie"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:background="@drawable/rounded_background"
            android:padding="15dp"
            android:inputType="text"
            android:textAllCaps="true"
            android:maxLength="8"
            android:layout_marginBottom="15dp"/>

        <Button
            android:id="@+id/joinGameButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Rejoindre"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_play"/>
    </LinearLayout>

</LinearLayout>


